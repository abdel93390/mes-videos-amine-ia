 "lignes": [
  {
   "id": "S1",
   "texte": "Alors, demain même heure ?",
   "debut": 0.06,
   "fin_fenetre": 3.75,
   "perso": "coach"
  },
  {
   "id": "S2",
   "texte": "On verra.",
   "debut": 3.8,
   "fin_fenetre": 8.61,
   "perso": "femme"
  },
  {
   "id": "S3",
   "texte": "Encore un entraînement tard ?",
   "debut": 8.66,
   "fin_fenetre": 10.57,
   "perso": "mari"
  },
  {
   "id": "S4",
   "texte": "Le coach dit que je progresse.",
   "debut": 10.62,
   "fin_fenetre": 12.63,
   "perso": "femme"
  },
  {
   "id": "S5",
   "texte": "Ce n'est pas ma question.",
   "debut": 12.68,
   "fin_fenetre": 14.43,
   "perso": "mari"
  },
  {
   "id": "S6",
   "texte": "Je suis fatiguée.",
   "debut": 14.48,
   "fin_fenetre": 20.39,
   "perso": "femme"
  },
  {
   "id": "S7",
   "texte": "Tu viens te coucher ?",
   "debut": 20.44,
   "fin_fenetre": 22.27,
   "perso": "femme"
  },
  {
   "id": "S8",
   "texte": "Laisse-moi reprendre mon souffle.",
   "debut": 22.32,
   "fin_fenetre": 27.05,
   "perso": "mari"
  },
  {
   "id": "S9",
   "texte": "Désolé.",
   "debut": 27.1,
   "fin_fenetre": 28.2,
   "perso": "mari"
  },
  {
   "id": "S10",
   "texte": "C'est rien.",
   "debut": 27.84,
   "fin_fenetre": 29.13,
   "perso": "femme"
  },
  {
   "id": "S11",
   "texte": "Ne fais pas semblant.",
   "debut": 29.18,
   "fin_fenetre": 38.53,
   "perso": "mari"
  },
  {
   "id": "S12",
   "texte": "Encore le cœur ?",
   "debut": 38.58,
   "fin_fenetre": 40.31,
   "perso": "ami"
  },
  {
   "id": "S13",
   "texte": "Un seul étage d'escalier.",
   "debut": 40.36,
   "fin_fenetre": 42.33,
   "perso": "mari"
  },
  {
   "id": "S14",
   "texte": "J'ai eu la même chose.",
   "debut": 42.38,
   "fin_fenetre": 43.95,
   "perso": "ami"
  },
  {
   "id": "S15",
   "texte": "Alors tu sais ce que ça fait au lit ?",
   "debut": 44.0,
   "fin_fenetre": 46.11,
   "perso": "mari"
  },
  {
   "id": "S16",
   "texte": "Deux ans, rien.",
   "debut": 46.16,
   "fin_fenetre": 50.65,
   "perso": "ami"
  },
  {
   "id": "S17",
   "texte": "C'est quoi ?",
   "debut": 50.7,
   "fin_fenetre": 51.89,
   "perso": "mari"
  },
  {
   "id": "S18",
   "texte": "MyBeet.",
   "debut": 51.94,
   "fin_fenetre": 53.19,
   "perso": "ami"
  },
  {
   "id": "S19",
   "texte": "De la betterave pressée à froid. Jamais chauffée.",
   "debut": 53.24,
   "fin_fenetre": 62.93,
   "perso": "ami"
  },
  {
   "id": "S21",
   "texte": "Les vaisseaux, là en bas, sont les plus petits de tout le corps.",
   "debut": 62.98,
   "fin_fenetre": 66.97,
   "perso": "ami"
  },
  {
   "id": "S22",
   "texte": "Ce sont les premiers à ne plus s'ouvrir.",
   "debut": 67.02,
   "fin_fenetre": 69.79,
   "perso": "ami"
  },
  {
   "id": "S23",
   "texte": "Avec l'âge, le corps fabrique trop peu d'oxyde nitrique.",
   "debut": 69.84,
   "fin_fenetre": 74.13,
   "perso": "ami"
  },
  {
   "id": "S24",
   "texte": "C'est le signal pour les vaisseaux : ouvrez-vous.",
   "debut": 74.18,
   "fin_fenetre": 78.23,
   "perso": "ami"
  },
  {
   "id": "S26",
   "texte": "Chaque année, il y en a moins.",
   "debut": 78.28,
   "fin_fenetre": 80.73,
   "perso": "ami"
  },
  {
   "id": "S27",
   "texte": "Les mêmes vaisseaux où ton cœur doit pousser le sang dans l'escalier.",
   "debut": 80.78,
   "fin_fenetre": 86.45,
   "perso": "ami"
  },
  {
   "id": "S28",
   "texte": "Les nitrates de betterave, le corps les transforme en oxyde nitrique.",
   "debut": 86.5,
   "fin_fenetre": 91.01,
   "perso": "ami"
  },
  {
   "id": "S29",
   "texte": "Les vaisseaux se rouvrent, et le sang circule à nouveau.",
   "debut": 91.6,
   "fin_fenetre": 95.85,
   "perso": "ami"
  },
  {
   "id": "S30",
   "texte": "1100 milligrammes par dose.",
   "debut": 95.9,
   "fin_fenetre": 98.99,
   "perso": "ami"
  },
  {
   "id": "S31",
   "texte": "Avec du fer et de la vitamine C.",
   "debut": 99.04,
   "fin_fenetre": 101.87,
   "perso": "ami"
  },
  {
   "id": "S32",
   "texte": "Deux gélules chaque matin.",
   "debut": 101.92,
   "fin_fenetre": 105.01,
   "perso": "ami"
  },
  {
   "id": "S33",
   "texte": "Et la première semaine ?",
   "debut": 105.06,
   "fin_fenetre": 107.11,
   "perso": "mari"
  },
  {
   "id": "S34",
   "texte": "Plus de pause au milieu de l'escalier.",
   "debut": 107.16,
   "fin_fenetre": 109.57,
   "perso": "ami"
  },
  {
   "id": "S35",
   "texte": "Au bout de deux mois, je suivais à nouveau ma femme.",
   "debut": 109.62,
   "fin_fenetre": 113.13,
   "perso": "ami"
  },
  {
   "id": "S36",
   "texte": "J'en prends encore aujourd'hui.",
   "debut": 113.18,
   "fin_fenetre": 114.77,
   "perso": "ami"
  },
  {
   "id": "S37",
   "texte": "Sérieux ?",
   "debut": 114.94,
   "fin_fenetre": 115.4,
   "perso": "mari"
  },
  {
   "id": "S38",
   "texte": "Demande à ma femme.",
   "debut": 115.78,
   "fin_fenetre": 145.05,
   "perso": "ami"
  },
  {
   "id": "S39",
   "texte": "Qu'est-ce que tu fais ?",
   "debut": 145.1,
   "fin_fenetre": 146.53,
   "perso": "femme"
  },
  {
   "id": "S40",
   "texte": "Je pars.",
   "debut": 146.58,
   "fin_fenetre": 147.67,
   "perso": "mari"
  },
  {
   "id": "S41",
   "texte": "Pour une seule mauvaise année ?",
   "debut": 147.72,
   "fin_fenetre": 149.43,
   "perso": "femme"
  },
  {
   "id": "S42",
   "texte": "Je sais ce qu'étaient tes entraînements.",
   "debut": 149.48,
   "fin_fenetre": 151.73,
   "perso": "mari"
  },
  {
   "id": "S43",
   "texte": "Je suis resté, je croyais que c'était moi le problème.",
   "debut": 151.78,
   "fin_fenetre": 157.01,
   "perso": "mari"
  },
  {
   "id": "S44",
   "texte": "Je ne le crois plus.",
   "debut": 157.06,
   "fin_fenetre": 162.09,
   "perso": "mari"
  },
  {
   "id": "S45",
   "texte": "C'est pris ?",
   "debut": 162.14,
